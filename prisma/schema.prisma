generator client {
  provider = "prisma-client"
  output   = "../src/generated"
  binaryTargets = ["native"]
  importFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

model Quiz {
  id         Int     @id @default(autoincrement())
  title      String
  categoryId String?
  testId     String?
  difficulty Int 
  tasks      Task[]
  result UserResultTest[]
}

model Task {
  id            Int      @id @default(autoincrement())
  question      String
  correctAnswer String   @default("unknown")
  answers       String[]

  quizId        Int
  quiz          Quiz     @relation(fields: [quizId], references: [id])
}

model UserAnswer {
  id         Int      @id @default(autoincrement())
  userAnswer Int?
  createdAt  DateTime @default(now())
}

model User {
  id             Int      @id @default(autoincrement())
  login          String   @unique
  password       String 
  userResultTest UserResultTest[]
  createdAt      DateTime @default(now())
}

model UserResultTest {
  id     Int @id @default(autoincrement())
  grade  Int             
  userId Int
  user   User @relation(fields: [userId], references: [id])
  quizId Int
  quiz   Quiz @relation(fields: [quizId], references: [id])
  updatedAt DateTime @updatedAt
  
  @@unique([userId, quizId])
}
