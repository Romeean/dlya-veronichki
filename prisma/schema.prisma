generator client {
  provider = "prisma-client"
  output   = "../src/generated"
  binaryTargets = ["native"]
  importFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

model Quiz {
  id         Int     @id @default(autoincrement())
  
  title      String
  categoryId String?
  testId     String?
  difficulty Int 
  tasks      Task[]
}

model Task {
  id            Int      @id @default(autoincrement())
  question      String
  quizId        Int
  correctAnswer String   @default("nothing")
  answers       String[]
  quiz          Quiz     @relation(fields: [quizId], references: [id])
}

model UserAnswer {
  id         Int      @id @default(autoincrement())
  userAnswer Int?
  createdAt  DateTime @default(now())
}

model User {
  id Int     @id @default(autoincrement())

  userId    Int
  login     String   
  password  String 


  createdAt DateTime @default(now())
}

model UserResultTest {
  id Int @id @default(autoincrement())
  grade  Int             
  userId Int
  quizId Int
  updatedAt DateTime @updatedAt
  @@unique([userId, quizId])
}
